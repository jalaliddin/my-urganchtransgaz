# Copy to `.env` at the repo root (gitignored) before running
# `docker compose up -d --build`. This one file feeds two things:
# docker-compose.yml's own `${VAR}` interpolation (DB_PASSWORD,
# MYSQL_ROOT_PASSWORD, VITE_API_URL), and — via `env_file: .env` on the
# backend/scheduler/artisan services — every environment variable Laravel
# itself reads. See README.md's "Docker deployment" section.

APP_NAME="Urganchtransgaz Korporativ Portali"
APP_ENV=production
# Generate once with: docker compose run --rm artisan key:generate --show
# then paste the `base64:...` result here. Never regenerate an existing
# one in place — every already-issued Sanctum token and encrypted value
# (e.g. any encrypted casts) becomes unreadable the moment the key changes.
APP_KEY=
APP_DEBUG=false
APP_URL=https://my.urtg.uz
FRONTEND_URL=https://my.urtg.uz
APP_TIMEZONE=Asia/Tashkent

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# DB_HOST/DB_PORT are set directly in docker-compose.yml (both point at the
# `db` service) — only the credentials live here, shared with the `db`
# service's own MYSQL_USER/MYSQL_PASSWORD via the same variable names.
DB_CONNECTION=mysql
DB_DATABASE=my_urtg
DB_USERNAME=my_urtg
DB_PASSWORD=change-me-to-a-real-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-real-password

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@my.urtg.uz"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=

# Baked into the frontend's compiled JS at build time (see
# frontend/Dockerfile) — a plain https URL, not a compose service name,
# since it's fetched from the end user's own browser, not from inside the
# Docker network.
VITE_API_URL=https://my.urtg.uz/api/v1

# Host port the `nginx` (reverse-proxy) service binds to. Change this if
# something else on the host already owns it — see docker-compose.yml's
# comment on the `nginx` service.
HTTP_PORT=8090
