# Copy this file to android/key.properties (gitignored — never commit the
# real one) and fill in the values from your own upload keystore.
#
# Generate a new upload keystore once, per the instructions in
# mobile/README.md's "Google Play Console" section:
#
#   keytool -genkeypair -v -keystore android/app/upload-keystore.jks \
#     -alias urtg_upload -keyalg RSA -keysize 2048 -validity 10000
#
# Back up the .jks file and these passwords somewhere durable (a password
# manager, not just this machine) — losing them means you can never publish
# an update to the same Play Store listing again.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=urtg_upload
storeFile=upload-keystore.jks
