# Copy this file to .env and fill in real values. Nothing here is read from
# anywhere else — there is no hidden default for a device credential.

# --- The Dahua terminal, on the local network ---
DEVICE_HOST=192.168.1.108
DEVICE_PORT=80
DEVICE_USERNAME=admin
DEVICE_PASSWORD=change-me
# The Dahua-side channel a multi-channel device should report events for.
# Leave unset for a single-channel terminal (the default, channel 1).
# DEVICE_CHANNEL=1

# --- my.urtg.uz ---
# The backend's API base URL. Use the real domain in production; a local
# backend during setup/testing (e.g. http://192.168.1.50:8000/api/v1).
SERVER_URL=https://my.urtg.uz/api/v1
# The token printed once by, on the backend:
#   php artisan attendance:create-device <device_id> "<name>" [--organization_id=]
DEVICE_TOKEN=change-me
# Must match the device_id that command was given.
DEVICE_ID=TURNSTILE-MAIN-GATE

# --- Direction (check-in vs check-out) ---
# "fixed": this bridge instance always reports the same direction — for a
# site with two separate terminals, one on the entry side of a gate and
# one on the exit side, each its own IP (run one bridge instance per
# terminal; see README.md's "Two separate entry/exit terminals").
# DIRECTION_MODE=fixed
# FIXED_DIRECTION=check_in
#
# "toggle" (the default): no device field is trusted for direction. Each
# person's first scan on a given day is a check-in, their next scan that
# day is a check-out, and so on — the right default for a single terminal
# with one reader and no separate "which way" signal. State is kept in
# DATA_DIR/direction-state.json and resets at local midnight.
#
# "field": trust a field the device actually reports (commonly a door or
# reader number — two readers on the same terminal, one per direction —
# or, on at least one real terminal seen during development, a plain
# `Type` field with the literal value "Entry" or "Exit"). Only use this
# after confirming with LOG_RAW_EVENTS=true (see below) that the field is
# present and consistent — the exact field name and value meanings are
# not the same across every Dahua model.
DIRECTION_MODE=toggle
# Comma-separated, tried in order; the first one present in the event
# wins. The default already includes the field a real terminal was
# observed using (Type=Entry/Exit) ahead of the door/reader-number guess.
# DIRECTION_FIELD=Type,Door,ReaderID
# ENTRY_VALUES=1,Entry
# EXIT_VALUES=2,Exit

# --- Diagnostics ---
# Print every parsed event's raw fields instead of (or as well as) acting
# on them — run this first, on-site, before trusting DIRECTION_MODE=field
# or the person-id field guess below.
LOG_RAW_EVENTS=false
# Parse and log events but never call the webhook. Use together with
# LOG_RAW_EVENTS to safely observe a live terminal.
DRY_RUN=false

# Candidate field names (comma-separated) tried in order to find the
# device's own person id for a scan; the first one present in the event
# wins. The default's order was confirmed live: a real terminal reported
# these flat (UserID, CardNo), not nested under "AccessControl." the way
# the vendor's own documentation excerpt suggested — that nested form is
# kept only as a fallback for a different terminal model.
PERSON_ID_FIELDS=UserID,CardNo,AccessControl.UserID,AccessControl.CardNo

# Same idea, for finding the event's own type/code field — a real
# terminal was observed nesting it as EventBaseInfo.Code rather than the
# bare Code the vendor's documentation excerpt shows.
CODE_FIELDS=EventBaseInfo.Code,Code

LOG_LEVEL=info

# Where the offline queue and direction-state files live. Give each bridge
# instance (each terminal) its own — never share one between two running
# instances, or their queues/state will corrupt each other.
# DATA_DIR=./data

# Only needed when running more than one instance from this same folder
# without systemd (systemd's own EnvironmentFile= already sets these
# variables directly — see scripts/dahua-bridge@.service). Points at a
# specific env file instead of the default .env, e.g.:
#   ENV_FILE_PATH=.env.turnstile-1 node src/index.js
# ENV_FILE_PATH=.env

# --- Historical records (recordFinder.cgi) ---
# Pulls what the live event subscription can't: everything that already
# happened before this bridge connected. See README.md's "Historical
# records and backfill" section.
RECORD_FINDER_ENABLED=true
# The one record type name Dahua's documentation gives for access-control
# card/fingerprint/face records. Change only for a model that uses a
# different name.
# RECORD_FINDER_NAME=AccessControlCardRec
# The device's own documented default/cap per request — this endpoint has
# no confirmed pagination beyond it (see the README).
# RECORD_FINDER_COUNT=1024
# Runs once at startup, resuming from the last record this bridge already
# processed (DATA_DIR/backfill-state.json).
BACKFILL_ON_START=true
# A specific starting point (anything JavaScript's Date can parse, e.g.
# "2026-01-01") for the very first run only, before any state file
# exists — otherwise a fresh install's first run looks back just one day.
# Has no effect once backfill-state.json exists.
# BACKFILL_SINCE=2026-01-01
# Repeats the same gap-fill periodically as a safety net alongside the
# live subscription. 0 disables it.
RECONCILE_INTERVAL_MINUTES=30
