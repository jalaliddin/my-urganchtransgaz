# Copy this file to .env and fill in real values. Nothing here is read from
# anywhere else — there is no hidden default for a device credential.

# --- The Dahua terminal, on the local network ---
DEVICE_HOST=192.168.1.108
DEVICE_PORT=80
DEVICE_USERNAME=admin
DEVICE_PASSWORD=change-me
# The Dahua-side channel a multi-channel device should report events for.
# Leave unset for a single-channel terminal (the default, channel 1).
# DEVICE_CHANNEL=1

# --- my.urtg.uz ---
# The backend's API base URL. Use the real domain in production; a local
# backend during setup/testing (e.g. http://192.168.1.50:8000/api/v1).
SERVER_URL=https://my.urtg.uz/api/v1
# The token printed once by, on the backend:
#   php artisan attendance:create-device <device_id> "<name>" [--organization_id=]
DEVICE_TOKEN=change-me
# Must match the device_id that command was given.
DEVICE_ID=TURNSTILE-MAIN-GATE

# --- Direction (check-in vs check-out) ---
# "toggle": no device field is trusted for direction. Each person's first
# scan on a given day is a check-in, their next scan that day is a
# check-out, and so on — the right default for a single-lane turnstile
# with one reader and no separate "which way" signal. State is kept in
# ./data/direction-state.json and resets at local midnight.
#
# "field": trust a field the device actually reports (commonly a door or
# reader number — two readers on the same terminal, one per direction).
# Only use this after confirming with LOG_RAW_EVENTS=true (see below) that
# the field is present and consistent — the exact field name and value
# meanings are not the same across every Dahua model.
DIRECTION_MODE=toggle
# DIRECTION_FIELD=AccessControl.Door
# ENTRY_VALUES=1
# EXIT_VALUES=2

# --- Diagnostics ---
# Print every parsed event's raw fields instead of (or as well as) acting
# on them — run this first, on-site, before trusting DIRECTION_MODE=field
# or the person-id field guess below.
LOG_RAW_EVENTS=false
# Parse and log events but never call the webhook. Use together with
# LOG_RAW_EVENTS to safely observe a live terminal.
DRY_RUN=false

# Candidate field names (comma-separated) tried in order to find the
# device's own person id for a scan; the first one present in the event
# wins. Adjust from what LOG_RAW_EVENTS shows for your device model.
PERSON_ID_FIELDS=AccessControl.UserID,AccessControl.CardNo,UserID,CardNo

LOG_LEVEL=info
